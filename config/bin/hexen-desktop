#!/usr/bin/env bash
set -euo pipefail
missing() { notify-send 'Hexen' "$1 is not installed. See docs/app-sources.md."; exit 1; }

screenshot_path() {
  local directory="$HOME/Pictures/Screenshots" stamp candidate suffix=0
  mkdir -p -- "$directory"
  stamp=$(date +%Y-%m-%d_%H-%M-%S)
  candidate="$directory/screenshot-$stamp.png"
  while [[ -e $candidate ]]; do
    suffix=$((suffix + 1))
    candidate="$directory/screenshot-$stamp-$suffix.png"
  done
  printf '%s\n' "$candidate"
}

capture_screenshot() {
  local mode=${1:-region} geometry output active_workspace window_rects
  local destination temp_dir temp_image
  command -v grim >/dev/null || missing Grim
  command -v wl-copy >/dev/null || missing 'wl-clipboard'

  case "$mode" in
    region|annotate)
      command -v slurp >/dev/null || missing Slurp
      geometry=$(slurp) || return 0
      [[ -n $geometry ]] || return 0
      ;;
    window)
      command -v slurp >/dev/null || missing Slurp
      command -v hyprctl >/dev/null || missing Hyprland
      command -v jq >/dev/null || missing jq
      active_workspace=$(hyprctl -j activeworkspace | jq -er '.id') || return 1
      window_rects=$(hyprctl -j clients | jq -r --argjson workspace "$active_workspace" '
        .[]
        | select(.mapped == true and .hidden == false and .workspace.id == $workspace)
        | select(.size[0] > 0 and .size[1] > 0)
        | "\((.at[0] | floor)),\((.at[1] | floor)) \((.size[0] | floor))x\((.size[1] | floor)) \((.title // .class // "Window" | gsub("[\\r\\n]"; " ")))"
      ')
      [[ -n $window_rects ]] || { notify-send 'Screenshot' 'No visible windows on this workspace'; return 0; }
      geometry=$(printf '%s\n' "$window_rects" | slurp -r -f '%x,%y %wx%h') || return 0
      [[ -n $geometry ]] || return 0
      ;;
    display)
      command -v hyprctl >/dev/null || missing Hyprland
      command -v jq >/dev/null || missing jq
      output=$(hyprctl -j monitors | jq -er '.[] | select(.focused == true) | .name') || return 1
      ;;
    *) printf 'Unknown screenshot mode: %s\n' "$mode" >&2; return 2 ;;
  esac

  destination=$(screenshot_path)
  temp_dir=$(mktemp -d "${destination%/*}/.hexen-screenshot.XXXXXX") || return 1
  temp_image="$temp_dir/capture.png"
  trap -- "rm -rf -- $(printf '%q' "$temp_dir")" EXIT

  if [[ $mode == annotate ]]; then
    command -v swappy >/dev/null || missing Swappy
    grim -g "$geometry" - | swappy -f - -o - > "$temp_image"
  elif [[ $mode == display ]]; then
    grim -o "$output" "$temp_image"
  else
    grim -g "$geometry" "$temp_image"
  fi
  [[ -s $temp_image ]] || { notify-send 'Screenshot' 'Capture produced no image'; return 1; }
  mv -- "$temp_image" "$destination"
  wl-copy --type image/png < "$destination"
  notify-send 'Screenshot saved and copied' "$destination"
}

selected_launcher() {
  local config="$HOME/.config/hexen/launcher" backend
  if [[ ! -r $config ]]; then
    printf 'walker\n'
    return
  fi
  IFS= read -r backend < "$config" || true
  case "$backend" in
    fuzzel|walker) printf '%s\n' "$backend" ;;
    *) printf 'Invalid launcher setting in %s\n' "$config" >&2; return 2 ;;
  esac
}

pick_menu() {
  local prompt=${1:?menu prompt is required} backend
  shift
  backend=$(selected_launcher) || exit 2
  case "$backend" in
    fuzzel)
      command -v fuzzel >/dev/null || missing Fuzzel
      fuzzel --dmenu --prompt="$prompt" "$@" ;;
    walker)
      command -v walker >/dev/null || missing Walker
      walker --dmenu --placeholder="$prompt" "$@" ;;
  esac
}

launch_apps() {
  local backend
  backend=$(selected_launcher) || exit 2
  case "$backend" in
    fuzzel)
      command -v fuzzel >/dev/null || missing Fuzzel
      exec fuzzel ;;
    walker)
      command -v walker >/dev/null || missing Walker
      exec walker ;;
  esac
}

case "${1:-}" in
  launcher) launch_apps ;;
  start-session)
    backend=$(selected_launcher) || exit 2
    if [[ $backend == walker ]]; then
      command -v walker >/dev/null || missing Walker
      command -v elephant >/dev/null || missing Elephant
      systemctl --user daemon-reload
      systemctl --user start hexen-elephant.service
      exec walker --gapplication-service
    fi ;;
  browser|browser-private)
    if command -v zen-browser >/dev/null; then browser=zen-browser
    elif command -v firefox >/dev/null; then browser=firefox
    else missing 'Zen Browser or Firefox'; fi
    if [[ $1 == browser-private ]]; then exec "$browser" --private-window; fi
    exec "$browser" ;;
  passwords)
    command -v 1password >/dev/null || missing '1Password'
    exec 1password ;;
  clipboard)
    entries=$(cliphist list) || exit 1
    [[ -n $entries ]] || exit 0
    choice=$(printf '%s\n' "$entries" | pick_menu 'Clipboard: ') || exit 0
    [[ -n $choice ]] || exit 0
    printf '%s\n' "$choice" | cliphist decode | wl-copy ;;
  monitors)
    command -v hyprmon >/dev/null || missing Hyprmon
    state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
    if [[ -r "$HOME/.config/hexen/state-home" ]]; then
      IFS= read -r state_home < "$HOME/.config/hexen/state-home" || true
    fi
    [[ $state_home == /* ]] || { printf 'Hexen state directory must be absolute\n' >&2; exit 2; }
    monitor_dir="$state_home/hexen/displays"
    mkdir -p -- "$monitor_dir"
    monitor_config="$monitor_dir/hyprland.lua"
    if [[ ! -e $monitor_config && ! -L $monitor_config ]]; then
      (set -o noclobber; printf '%s\n' '-- Machine-local Hyprmon target; Hexen loads the generated hyprmon.lua.' > "$monitor_config")
    fi
    exec ghostty -e env "HYPRLAND_CONFIG=$monitor_config" hyprmon ;;
  screensaver) exec "$HOME/.local/bin/hexen-screensaver" start ;;
  screenshot)
    capture_screenshot region ;;
  screenshot-menu)
    choice=$(printf '%s\n' 'Region' 'Window' 'Full display' 'Annotated region' | pick_menu 'Screenshot: ') || exit 0
    case "$choice" in
      Region) capture_screenshot region ;;
      Window) capture_screenshot window ;;
      'Full display') capture_screenshot display ;;
      'Annotated region') capture_screenshot annotate ;;
    esac ;;
  menu)
    choice=$(printf '%s\n' 'Applications' 'Themes' 'Screensaver' 'Display settings' 'Edit keybindings' 'Edit Hyprland appearance' 'System' | pick_menu 'Hexen: ') || exit 0
    case "$choice" in
      Applications) exec "$0" launcher ;;
      Themes) exec "$HOME/.local/bin/hexen-theme" ;;
      Screensaver) exec "$0" screensaver ;;
      'Display settings') exec "$0" monitors ;;
      'Edit keybindings') exec ghostty nvim "$HOME/.config/hypr/bindings.lua" ;;
      'Edit Hyprland appearance') exec ghostty nvim "$HOME/.config/hypr/theme.lua" ;;
      System) exec "$0" system-menu ;;
    esac ;;
  system-menu)
    choice=$(printf '%s\n' \
      '  Lock' \
      '󰒲  Suspend' \
      '󰍃  Log out' \
      '󰜉  Restart' \
      '󰐥  Shut down' \
      | pick_menu 'System  ›  ') || exit 0
    case "$choice" in
      *Lock*) exec loginctl lock-session ;;
      *Suspend*) exec systemctl suspend ;;
      *'Log out'*) exec hyprctl dispatch 'hl.dsp.exit()' ;;
      *Restart*) exec systemctl reboot ;;
      *'Shut down'*) exec systemctl poweroff ;;
    esac ;;
  *) printf 'Usage: %s {launcher|start-session|browser|browser-private|passwords|clipboard|screenshot|screenshot-menu|screensaver|monitors|menu|system-menu}\n' "$0" >&2; exit 2 ;;
esac
