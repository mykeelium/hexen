#!/usr/bin/env python3
"""Preserve machine-local HyprMon settings while clearing Hexen's update blocker."""
import argparse
from datetime import datetime, timezone
from pathlib import Path
import shutil
import subprocess


def repair(root: Path, apply: bool = False):
    main = root / 'config/hypr/hyprland.lua'
    local = root / 'config/hypr/local.lua'
    generated = root / 'config/hypr/hyprmon.lua'
    baseline = subprocess.check_output(
        ['git', '-C', str(root), 'show', 'HEAD:config/hypr/hyprland.lua']
    )
    extra = b'\n-- hyprmon: managed monitor profile include\nrequire("hyprmon")\n'
    original = main.read_bytes()
    if original not in (baseline, baseline + extra):
        raise RuntimeError('hyprland.lua contains additional edits; refusing to overwrite them.')
    if not generated.is_file():
        raise RuntimeError('Expected the existing generated hyprmon.lua configuration.')
    local_original = local.read_bytes() if local.exists() else b''
    include = b'require("hyprmon")'
    local_updated = local_original
    if include not in local_updated and b"require('hyprmon')" not in local_updated:
        local_updated += b'\n-- Machine-local monitor profile generated by HyprMon.\n' + include + b'\n'
    backups = sorted(main.parent.glob('hyprland.lua.bak.*'))
    backups += sorted(main.parent.glob('local.lua.before-drata.*'))
    exclude = root / '.git/info/exclude'
    excluded = exclude.read_text() if exclude.exists() else ''
    rule = '/config/hypr/hyprmon.lua'
    print('Keep generated hyprmon.lua in place and exclude it from local Git status.')
    print('Load HyprMon from the already-ignored local.lua; restore hyprland.lua to HEAD.')
    print(f'Archive {len(backups)} existing config backups outside the repository.')
    if not apply:
        print('Preview only. Run with --apply to make these changes.')
        return
    archive = Path.home() / 'recovery/hexen-config-repair' / datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
    archive.mkdir(parents=True, mode=0o700)
    (archive / 'hyprland.lua.before').write_bytes(original)
    (archive / 'local.lua.before').write_bytes(local_original)
    for path in backups:
        if path.is_symlink() or not path.is_file():
            raise RuntimeError(f'Unexpected backup type: {path}')
        shutil.copy2(path, archive / path.name)
    if main.read_bytes() != original or (local.read_bytes() if local.exists() else b'') != local_original:
        raise RuntimeError('Configuration changed during repair; retry.')
    # Write the local include before removing the original, retaining the same settings.
    local.write_bytes(local_updated)
    if rule not in excluded.splitlines():
        exclude.parent.mkdir(parents=True, exist_ok=True)
        exclude.write_text(excluded.rstrip() + '\n\n# Machine-local HyprMon output\n' + rule + '\n')
    main.write_bytes(baseline)
    for path in backups:
        if path.read_bytes() != (archive / path.name).read_bytes():
            raise RuntimeError(f'Backup changed during repair; retained in place: {path}')
        path.unlink()
    print(f'Configuration safety copies: {archive}')
    subprocess.run(['git', '-C', str(root), 'status', '--short'], check=True)
    print('Repair complete. No package update or configuration reload was performed.')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--apply', action='store_true')
    parser.add_argument('--repo', type=Path, default=Path(__file__).resolve().parents[2],
                        help='Hexen repository (default: repository containing this command)')
    args = parser.parse_args()
    repair(args.repo.expanduser().resolve(), args.apply)
