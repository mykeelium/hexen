#!/usr/bin/env python3
"""Manage Hexen configuration and update workflows."""

from __future__ import annotations

import argparse
from dataclasses import dataclass, field
import fcntl
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile


REPO_ROOT = Path(__file__).resolve().parents[2]
PROFILE_RE = re.compile(r"^hexen_machine_profile:\s*([^\s#]+)")
REMOTE_RE = re.compile(r"^desktop_remote_access_enabled:\s*(true|false)\s*(?:#.*)?$", re.I)
PROFILES = {"common", "numen", "arcana"}
CONFIG_DIRS = [
    "hypr", "ghostty", "mako", "xdg-desktop-portal", "nvim", "lazydocker",
    "elephant", "swappy", "starship.toml",
]
HELPERS = ["hexen", "hexen-desktop", "hexen-theme", "hexen-screensaver"]
MIGRATION_ID_RE = re.compile(r"^[0-9]{3}_[a-z0-9][a-z0-9_-]*$")
MIGRATION_MANIFEST = REPO_ROOT / "install/migrations/manifest.json"
LOCALSEND_DEFAULTS = REPO_ROOT / "ansible/roles/desktop/defaults/main.yml"
LOCAL_MANUAL_PACKAGES = (
    "zen-browser-bin", "1password", "zoom", "slack-desktop", "walker",
    "elephant", "elephant-desktopapplications", "elephant-files",
    "elephant-runner", "elephant-calc", "elephant-websearch",
    "elephant-providerlist",
)


class ConfigError(Exception):
    pass


@dataclass(frozen=True)
class UpdateCandidate:
    name: str
    old: str
    new: str
    repo: str


@dataclass(frozen=True)
class UpdateDiscovery:
    checked_at: str
    status: str
    detail: str
    report_path: Path
    packages: tuple[UpdateCandidate, ...]
    exit_code: int


@dataclass
class UpdateReviewState:
    """Presentation-independent package choices and review outcome."""
    discovery: UpdateDiscovery
    decisions: dict[str, str] = field(default_factory=dict)

    def record_choice(self, candidate: UpdateCandidate, decision: str) -> None:
        if candidate not in self.discovery.packages:
            raise ConfigError("package is not part of this update review")
        if decision not in {"reviewed", "wanted", "follow-up", "undecided"}:
            raise ConfigError(f"unsupported package review decision: {decision}")
        record_update_review_choice(self.discovery, candidate, decision)
        self.decisions[candidate.name] = decision

    def record_outcome(self, decision: str) -> None:
        if decision not in {"interrupted", "cancelled", "handoff-to-full-update"}:
            raise ConfigError(f"unsupported update review outcome: {decision}")
        append_update_evidence(private_update_state(), {
            "time": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "event": "review-summary", "review_id": self.discovery.checked_at,
            "decision": decision, "packages": self.decisions,
            "completed_packages": len(self.decisions),
            "total_packages": len(self.discovery.packages),
        })


def source_status_lines(package_manifest: str | None) -> list[str]:
    """Report local integrity/installation facts without querying upstreams."""
    lines = ["Application source checks (local state; no upstream update checks):"]
    expected_hash = ""
    version = ""
    try:
        if LOCALSEND_DEFAULTS.is_symlink() or not LOCALSEND_DEFAULTS.is_file():
            raise OSError("desktop defaults file is missing or unsafe")
        for line in LOCALSEND_DEFAULTS.read_text(encoding="utf-8").splitlines():
            hash_match = re.match(r"^desktop_localsend_sha256:\s*([0-9a-f]{64})\s*$", line)
            version_match = re.match(r"^desktop_localsend_version:\s*([^\s#]+)", line)
            if hash_match:
                expected_hash = hash_match.group(1)
            if version_match:
                version = version_match.group(1)
    except (OSError, UnicodeError) as error:
        lines.append(f"  LocalSend: pin unavailable ({error})")
    else:
        image = Path.home() / ".local/opt/localsend/LocalSend.AppImage"
        if not expected_hash:
            lines.append("  LocalSend: no valid SHA-256 pin found")
        elif image.is_symlink():
            lines.append("  LocalSend: installed path is a symlink; refusing to hash it")
        elif not image.is_file():
            lines.append("  LocalSend: pinned AppImage is not installed")
        else:
            try:
                digest = hashlib.sha256()
                with image.open("rb") as stream:
                    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                        digest.update(chunk)
                status = "matches" if digest.hexdigest() == expected_hash else "DIFFERS from"
                lines.append(f"  LocalSend: installed AppImage {status} the tracked SHA-256 pin (version {version or 'unknown'})")
            except OSError as error:
                lines.append(f"  LocalSend: installed AppImage could not be checked ({error})")

    if package_manifest is None:
        lines.append("  AUR/vendor/Walker packages: installed package inventory unavailable")
    else:
        installed = {}
        for row in package_manifest.splitlines():
            columns = row.split(None, 1)
            if len(columns) == 2:
                installed[columns[0]] = columns[1]
        present_manual = [f"{name} {installed[name]}" for name in LOCAL_MANUAL_PACKAGES if name in installed]
        lines.append("  AUR/vendor/Walker packages: " + (", ".join(present_manual) if present_manual else "none of the tracked candidates detected"))
        lines.append("    Installed versions are inventory only; recipe/vendor freshness remains a separate review.")

    flatpak = shutil.which("flatpak")
    if not flatpak:
        lines.append("  Bitwarden Flatpak: flatpak command unavailable")
    else:
        try:
            result = subprocess.run(
                [flatpak, "info", "--system", "--show-version", "com.bitwarden.desktop"],
                text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
            )
            if result.returncode == 0 and result.stdout.strip():
                lines.append(f"  Bitwarden Flatpak: installed version {result.stdout.strip()}; Flathub freshness not queried")
            else:
                lines.append("  Bitwarden Flatpak: system installation not found or unavailable")
        except OSError as error:
            lines.append(f"  Bitwarden Flatpak: check unavailable ({error})")

    hyprmon = Path.home() / ".local/bin/hyprmon"
    if hyprmon.is_symlink():
        lines.append("  Hyprmon: installed path is a symlink; source revision not checked")
    elif hyprmon.is_file():
        lines.append("  Hyprmon: local binary present; pinned build revision not checked")
    else:
        lines.append("  Hyprmon: local binary not found")

    lockfile = REPO_ROOT / "config/nvim/lazy-lock.json"
    try:
        if lockfile.is_symlink() or not lockfile.is_file():
            raise OSError("tracked lockfile is missing or unsafe")
        pins = json.loads(lockfile.read_text(encoding="utf-8"))
        if not isinstance(pins, dict):
            raise ValueError("lockfile must contain an object")
        lines.append(f"  Neovim plugins: {len(pins)} tracked pins; deployed plugin revisions are not compared")
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        lines.append(f"  Neovim plugins: tracked pin inventory unavailable ({error})")
    return lines


def offer_service_restart_review(log: Path) -> tuple[str, bool]:
    """Offer Arch's interactive process/service restart check without pacdiff."""
    checker = shutil.which("checkservices")
    if not checker:
        print("Service restart review unavailable: install archlinux-contrib with the reviewed provisioner.")
        update_log(log, "Service restart review unavailable: checkservices is not installed.")
        return "unavailable", False
    print("Arch checkservices will reload systemd, inspect processes using replaced files, and ask before each service restart; pacdiff is skipped.")
    try:
        answer = input("Run this service review now? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if answer not in {"y", "yes"}:
        update_log(log, "Interactive service restart review declined.")
        return "declined", False
    transcript = log.parent / "service-restart-review.log"
    try:
        result = subprocess.run(
            ["script", "--quiet", "--flush", "--return", "--append", "--command",
             shlex.join(["sudo", checker, "-P"]), str(transcript)],
            check=False,
        )
    except OSError as error:
        update_log(log, f"Service restart review could not start: {error}")
        return f"could-not-start: {error}", True
    status = "ran" if result.returncode == 0 else f"failed-{result.returncode}"
    update_log(log, f"Interactive service restart review {status}; transcript: {transcript}")
    print(f"Service restart review: {status}; transcript: {transcript}")
    return status, result.returncode != 0


def repo_git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "--no-pager", "-C", str(REPO_ROOT), *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        env={**os.environ, "GIT_PAGER": "cat", "PAGER": "cat"},
    )


def local_setting(pattern: re.Pattern[str], default: str) -> str:
    path = REPO_ROOT / "ansible/group_vars/all/local.yml"
    if not path.exists():
        return default
    if path.is_symlink() or not path.is_file():
        raise ConfigError(f"refusing to read unsafe local settings path: {path}")
    for line in path.read_text(encoding="utf-8").splitlines():
        match = pattern.match(line)
        if match:
            return match.group(1).strip("'\"")
    return default


def expected_links(home: Path) -> dict[Path, Path]:
    config = home / ".config"
    expected = {config / name: REPO_ROOT / "config" / name for name in CONFIG_DIRS}

    launcher = "walker"
    launcher_file = config / "hexen/launcher"
    if launcher_file.is_file() and not launcher_file.is_symlink():
        configured = launcher_file.read_text(encoding="utf-8").splitlines()
        if configured:
            launcher = configured[0].strip()
    if launcher not in {"walker", "fuzzel"}:
        raise ConfigError(f"unknown installed launcher in {launcher_file}: {launcher!r}")
    if launcher == "fuzzel":
        expected[config / "fuzzel"] = REPO_ROOT / "config/fuzzel"

    for name, files in {
        "waybar": ["config.jsonc", "style.css"],
        "walker": ["config.toml", "themes/hexen/style.css"],
    }.items():
        for relative in files:
            expected[config / name / relative] = REPO_ROOT / "config" / name / relative

    for name in HELPERS:
        expected[home / ".local/bin" / name] = REPO_ROOT / "config/bin" / name
    expected[home / ".local/share/applications/hexen-themes.desktop"] = (
        REPO_ROOT / "config/applications/hexen-themes.desktop"
    )
    expected[home / ".local/share/applications/hexen-theme-builder.desktop"] = (
        REPO_ROOT / "config/applications/hexen-theme-builder.desktop"
    )

    if launcher == "walker":
        expected[config / "systemd/user/hexen-elephant.service"] = (
            REPO_ROOT / "config/systemd/user/hexen-elephant.service"
        )
    for unit in ("hexen-update-monitor.service", "hexen-update-monitor.timer"):
        expected[config / "systemd/user" / unit] = REPO_ROOT / "config/systemd/user" / unit
    expected[config / "systemd/user/timers.target.wants/hexen-update-monitor.timer"] = (
        REPO_ROOT / "config/systemd/user/hexen-update-monitor.timer"
    )
    if local_setting(REMOTE_RE, "false").lower() == "true":
        expected[home / ".local/bin/hexen-remote"] = REPO_ROOT / "config/bin/hexen-remote"
        expected[config / "systemd/user/hexen-remote.service"] = (
            REPO_ROOT / "config/systemd/user/hexen-remote.service"
        )
    return expected


def command_status() -> int:
    profile = local_setting(PROFILE_RE, "common")
    if profile not in PROFILES:
        raise ConfigError(f"unknown machine profile in local.yml: {profile!r}")

    revision = repo_git("rev-parse", "--short", "HEAD")
    if revision.returncode:
        raise ConfigError(revision.stderr.strip() or "cannot read repository revision")
    dirty = repo_git("status", "--short", "--untracked-files=normal")
    if dirty.returncode:
        raise ConfigError(dirty.stderr.strip() or "cannot read repository status")

    print(f"Profile: {profile}")
    print(f"Repository: {revision.stdout.strip()} ({'dirty' if dirty.stdout else 'clean'})")
    if dirty.stdout:
        print("Repository changes:")
        for line in dirty.stdout.splitlines():
            print(f"  {line}")

    print("Managed desktop links:")
    problems = 0
    for destination, source in sorted(expected_links(Path.home()).items()):
        label = destination.relative_to(Path.home())
        if not destination.is_symlink():
            if destination.exists():
                print(f"  UNEXPECTED regular path: {label}")
            else:
                print(f"  MISSING: {label}")
            problems += 1
            continue
        actual = destination.resolve(strict=False)
        wanted = source.resolve(strict=False)
        if actual != wanted:
            print(f"  UNEXPECTED target: {label} -> {destination.readlink()}")
            problems += 1
        else:
            print(f"  OK: {label}")
    return 1 if problems else 0


def command_update_check() -> int:
    """Report update signals from local metadata without changing the system."""
    failures = 0
    print("Hexen update check (read-only)")

    status = repo_git("status", "--porcelain=v1", "--untracked-files=normal")
    revision = repo_git("rev-parse", "--short", "HEAD")
    if status.returncode or revision.returncode:
        detail = status.stderr.strip() if status.returncode else revision.stderr.strip()
        print(f"Repository: unavailable ({detail or 'Git status failed'})")
        failures += 1
    else:
        print(f"Repository: {revision.stdout.strip()} ({'dirty' if status.stdout else 'clean'})")
        upstream = repo_git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
        if upstream.returncode:
            print("Upstream: not configured; cannot compare local commits")
        else:
            counts = repo_git("rev-list", "--left-right", "--count", f"HEAD...{upstream.stdout.strip()}")
            if counts.returncode:
                print(f"Upstream: comparison unavailable ({counts.stderr.strip() or 'Git comparison failed'})")
                failures += 1
            else:
                ahead, behind = (int(value) for value in counts.stdout.split())
                print(f"Upstream: {upstream.stdout.strip()} (cached tracking data; {ahead} ahead, {behind} behind)")
        if status.stdout:
            print("Repository changes:")
            for line in status.stdout.splitlines():
                print(f"  {line}")

    print("Official package updates:")
    pacman = shutil.which("pacman")
    if not pacman:
        print("  unavailable (pacman not found)")
    else:
        sync_dir = Path("/var/lib/pacman/sync")
        sync_files = [path for path in sync_dir.iterdir() if path.is_file()] if sync_dir.is_dir() else []
        if sync_files:
            last_sync = max(path.stat().st_mtime for path in sync_files)
            age_hours = max(0, (datetime.now().timestamp() - last_sync) / 3600)
            stamp = datetime.fromtimestamp(last_sync).astimezone().isoformat(timespec="minutes")
            freshness = "stale; run a normal sync before relying on this" if age_hours > 24 else "recent"
            print(f"  sync database: {stamp} ({freshness})")
        else:
            print("  sync database: missing; package result may be unavailable")
        try:
            packages = subprocess.run(
                [pacman, "-Qu"], text=True, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, check=False,
            )
        except OSError as error:
            print(f"  unavailable ({error})")
            failures += 1
        else:
            if packages.returncode == 1 and not packages.stdout.strip() and not packages.stderr.strip():
                # pacman -Qu uses a nonzero status when it has no package rows to print.
                print("  none listed by the local sync database")
            elif packages.returncode:
                print(f"  unavailable ({packages.stderr.strip() or 'pacman query failed'})")
                failures += 1
            elif packages.stdout.strip():
                updates = packages.stdout.strip().splitlines()
                print(f"  {len(updates)} update(s) listed by the local sync database:")
                for package in updates:
                    print(f"    {package}")
            else:
                print("  none listed by the local sync database")

    print("Reboot signal:")
    running_modules = Path("/usr/lib/modules") / os.uname().release
    if not running_modules.is_dir():
        print(f"  possible reboot pending: running kernel {os.uname().release} has no module tree")
    else:
        try:
            uptime = float(Path("/proc/uptime").read_text(encoding="ascii").split()[0])
            boot_time = datetime.now().timestamp() - uptime
            module_root = running_modules.parent
            newer = [
                path.name for path in module_root.iterdir()
                if path.is_dir() and path != running_modules and path.stat().st_mtime > boot_time
            ]
            if newer:
                print("  possible kernel reboot pending; module trees appeared since boot: " + ", ".join(sorted(newer)))
            else:
                print("  no kernel reboot signal detected (service-level restart needs are not checked)")
        except (OSError, ValueError, IndexError) as error:
            print(f"  unavailable ({error})")
            failures += 1

    installed_manifest: str | None = None
    if pacman:
        installed = subprocess.run(
            [pacman, "-Q"], text=True, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, check=False,
        )
        if installed.returncode == 0:
            installed_manifest = installed.stdout
    print("Application source checks (local state only):")
    for line in source_status_lines(installed_manifest):
        print(line)
    checker = shutil.which("checkservices")
    if checker:
        print("Service restart review: `sudo checkservices -P` is available; it reloads systemd as needed, skips pacdiff, and asks before restarting affected services.")
    else:
        print("Service restart review: checkservices is not installed (provided by archlinux-contrib).")

    print("Managed config links:")
    try:
        problems = []
        for destination, source in sorted(expected_links(Path.home()).items()):
            if not destination.is_symlink() or destination.resolve(strict=False) != source.resolve(strict=False):
                problems.append(destination.relative_to(Path.home()))
        if problems:
            print("  reconciliation needed:")
            for path in problems:
                print(f"    {path}")
        else:
            print("  links match this repository checkout")
    except (ConfigError, OSError, UnicodeError) as error:
        print(f"  unavailable ({error})")
        failures += 1
    print("Note: this check does not fetch Git data, refresh package databases, contact application upstreams, or modify files.")
    return 1 if failures else 0


def update_log(path: Path, message: str) -> None:
    with path.open("a", encoding="utf-8") as stream:
        stream.write(message.rstrip() + "\n")
        stream.flush()


def migration_state_root() -> Path:
    configured = os.environ.get("XDG_STATE_HOME")
    base = Path(configured).expanduser() if configured else Path.home() / ".local/state"
    if not base.is_absolute():
        raise ConfigError("XDG_STATE_HOME must be an absolute path")
    cursor = Path(base.anchor)
    for part in base.parts[1:]:
        cursor = cursor / part
        if cursor.is_symlink():
            raise ConfigError(f"refusing symlinked migration state path component: {cursor}")
    root = base / "hexen/migrations"
    # Create missing components without following symlinks. Existing ancestors
    # may be shared system directories; the Hexen state directory itself must
    # be a private, user-owned directory.
    missing: list[Path] = []
    cursor = root
    while not cursor.exists() and not cursor.is_symlink():
        missing.append(cursor)
        cursor = cursor.parent
    if cursor.is_symlink() or not cursor.is_dir():
        raise ConfigError(f"migration state path has an unsafe ancestor: {cursor}")
    for directory in reversed(missing):
        directory.mkdir(mode=0o700)
    for directory in (base,):
        if directory.is_symlink() or not directory.is_dir():
            raise ConfigError(f"migration state directory is unsafe: {directory}")
        info = directory.stat()
        if info.st_uid != os.getuid():
            raise ConfigError(f"migration state directory must be owned by this user: {directory}")
    for directory in (base / "hexen", root):
        info = directory.stat()
        if info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_mode & 0o700 != 0o700:
            raise ConfigError(f"migration state directory must be private, user-owned, and writable: {directory}")
    return root


def load_migrations() -> list[dict[str, str]]:
    migration_dir = MIGRATION_MANIFEST.parent
    if (migration_dir.is_symlink() or migration_dir.parent.is_symlink()
            or not migration_dir.is_dir() or MIGRATION_MANIFEST.is_symlink()):
        raise ConfigError("migration registry path is missing or unsafe")
    try:
        manifest = json.loads(MIGRATION_MANIFEST.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ConfigError(f"cannot read migration manifest: {error}") from error
    if not isinstance(manifest, dict) or manifest.get("schema_version") != 1:
        raise ConfigError("migration manifest has an unsupported schema")
    rows = manifest.get("migrations")
    if not isinstance(rows, list):
        raise ConfigError("migration manifest must contain a migrations list")
    migrations: list[dict[str, str]] = []
    seen: set[str] = set()
    prior_id = ""
    for row in rows:
        if not isinstance(row, dict):
            raise ConfigError("migration entry must be an object")
        migration_id, description, script_name = row.get("id"), row.get("description"), row.get("script")
        if (not isinstance(migration_id, str) or not MIGRATION_ID_RE.fullmatch(migration_id)
                or migration_id in seen or migration_id <= prior_id):
            raise ConfigError("migration IDs must be unique, numbered, and sorted")
        if not isinstance(description, str) or not description.strip():
            raise ConfigError(f"migration {migration_id} has no description")
        if not isinstance(script_name, str) or Path(script_name).name != script_name or not script_name.endswith(".py"):
            raise ConfigError(f"migration {migration_id} has an unsafe script path")
        script_path = migration_dir / script_name
        if script_path.is_symlink() or not script_path.is_file():
            raise ConfigError(f"migration script is missing or unsafe: {script_name}")
        migrations.append({"id": migration_id, "description": description.strip(), "script": str(script_path)})
        seen.add(migration_id)
        prior_id = migration_id
    return migrations


def pending_migrations(state: Path, migrations: list[dict[str, str]]) -> list[dict[str, str]]:
    pending = []
    for migration in migrations:
        marker = state / f"{migration['id']}.json"
        if marker.is_symlink():
            raise ConfigError(f"refusing symlinked migration marker: {marker}")
        if marker.exists():
            try:
                data = json.loads(marker.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as error:
                raise ConfigError(f"invalid migration completion marker {marker}: {error}") from error
            if not isinstance(data, dict) or data.get("id") != migration["id"]:
                raise ConfigError(f"invalid migration completion marker: {marker}")
        else:
            pending.append(migration)
    return pending


def run_migrations(log: Path) -> tuple[int, int]:
    """Run pending reviewed migrations as this user; return (completed, remaining)."""
    migrations = load_migrations()
    if not migrations:
        return 0, 0
    if os.geteuid() == 0:
        raise ConfigError("user migrations must run from an unprivileged user session")
    state = migration_state_root()
    lock_path = state / ".lock"
    if lock_path.is_symlink():
        raise ConfigError(f"refusing symlinked migration lock: {lock_path}")
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(lock_fd)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ConfigError(f"migration lock must be private and user-owned: {lock_path}")
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ConfigError("another Hexen migration run is already active") from error

        pending = pending_migrations(state, migrations)
        if not pending:
            return 0, 0
        completed = 0
        for migration in pending:
            update_log(log, f"Starting user migration {migration['id']}: {migration['description']}")
            print(f"Running {migration['id']}: {migration['description']}")
            with log.open("a", encoding="utf-8") as stream:
                stream.write(f"\n--- {migration['id']} ---\n")
                stream.flush()
                result = subprocess.run([sys.executable, migration["script"]], cwd=REPO_ROOT,
                                        stdout=stream, stderr=subprocess.STDOUT, check=False)
            if result.returncode:
                update_log(log, f"Migration {migration['id']} failed with status {result.returncode}; it remains pending.")
                print(f"Migration {migration['id']} failed (status {result.returncode}); see {log}")
                return completed, len(pending) - completed
            marker = state / f"{migration['id']}.json"
            payload = json.dumps({"id": migration["id"], "source_revision": repo_git("rev-parse", "HEAD").stdout.strip(),
                                  "completed_at": datetime.now(timezone.utc).isoformat()}, indent=2) + "\n"
            fd, temporary = tempfile.mkstemp(prefix=f".{migration['id']}.", suffix=".tmp", dir=state)
            try:
                os.fchmod(fd, 0o600)
                with os.fdopen(fd, "w", encoding="utf-8") as stream:
                    stream.write(payload)
                    stream.flush()
                    os.fsync(stream.fileno())
                os.replace(temporary, marker)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
            update_log(log, f"Migration {migration['id']} completed.")
            completed += 1
        return completed, 0
    finally:
        os.close(lock_fd)


def private_update_state() -> Path:
    """Create and validate private monitoring state directories."""
    state_home = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    root = state_home / "hexen/updates"
    if state_home.is_symlink():
        raise ConfigError(f"refusing symlinked XDG state directory: {state_home}")
    state_home.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not state_home.is_dir() or state_home.stat().st_uid != os.getuid():
        raise ConfigError(f"XDG state directory must be a user-owned directory: {state_home}")
    namespace = state_home / "hexen"
    for directory in (namespace, root):
        if directory.is_symlink():
            raise ConfigError(f"refusing symlinked update state directory: {directory}")
        directory.mkdir(mode=0o700, exist_ok=True)
        info = directory.stat()
        if not directory.is_dir() or info.st_uid != os.getuid():
            raise ConfigError(f"update state directory must be a user-owned directory: {directory}")
        if directory == namespace and info.st_mode & 0o022:
            raise ConfigError(f"Hexen state namespace must not be group/world-writable: {directory}")
        if directory == root and info.st_mode & 0o077:
            raise ConfigError(f"update state directory must be private and user-owned: {directory}")
    return root


def append_update_evidence(root: Path, event: dict[str, object]) -> None:
    """Append timestamped owner-visible evidence to a private JSONL file."""
    evidence = root / "evidence.jsonl"
    if evidence.is_symlink():
        raise ConfigError(f"refusing symlinked update evidence file: {evidence}")
    fd = os.open(evidence, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ConfigError(f"update evidence file must be private and user-owned: {evidence}")
        with os.fdopen(fd, "a", encoding="utf-8") as stream:
            fd = -1
            stream.write(json.dumps(event, sort_keys=True) + "\n")
    finally:
        if fd >= 0:
            os.close(fd)


def isolated_package_repositories(database: Path, names: list[str]) -> dict[str, str]:
    """Resolve candidate repositories from checkupdates' isolated sync database."""
    if not names:
        return {}
    pacman = shutil.which("pacman")
    if not pacman:
        raise ConfigError("pacman is unavailable; cannot resolve candidate repositories")
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    result = subprocess.run(
        [pacman, "--color", "never", "--dbpath", str(database), "-Si", *names],
        text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, env=env,
    )
    if result.returncode:
        raise ConfigError(result.stderr.strip() or "Pacman could not read candidate metadata from the isolated database")
    repositories: dict[str, str] = {}
    current: dict[str, str] = {}

    def save_record() -> None:
        package_name = current.get("Name", "")
        repository = current.get("Repository", "")
        if package_name and repository:
            repositories.setdefault(package_name, repository)

    for line in result.stdout.splitlines() + [""]:
        if not line.strip():
            save_record()
            current = {}
            continue
        key, separator, value = line.partition(":")
        if separator and key.strip() in {"Name", "Repository"}:
            current[key.strip()] = value.strip()
    missing = sorted(set(names) - repositories.keys())
    if missing:
        raise ConfigError("repository metadata missing from isolated database for: " + ", ".join(missing))
    return repositories


def command_update_monitor(notify: bool = True) -> UpdateDiscovery:
    """Run a non-installing check against checkupdates' isolated database."""
    root = private_update_state()
    now = datetime.now(timezone.utc)
    checked_at = now.isoformat(timespec="seconds")
    checkupdates = shutil.which("checkupdates")
    packages: list[dict[str, str]] = []
    status = "failed"
    detail = ""
    if not checkupdates:
        detail = "checkupdates is not installed; install pacman-contrib through the reviewed provisioner."
    else:
        database = root / "checkupdates-db"
        if database.is_symlink():
            raise ConfigError(f"refusing symlinked isolated package database: {database}")
        database.mkdir(mode=0o700, exist_ok=True)
        if database.stat().st_uid != os.getuid() or database.stat().st_mode & 0o077:
            raise ConfigError(f"isolated package database must be private and user-owned: {database}")
        env = os.environ.copy()
        env["CHECKUPDATES_DB"] = str(database)
        try:
            result = subprocess.run(
                [checkupdates, "--nocolor"], text=True, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, check=False, env=env, timeout=900,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            result = None
            detail = f"checkupdates could not complete: {error}"
        if result is not None:
            if result.returncode == 2 and not result.stdout.strip():
                status = "up-to-date"
            elif result.returncode == 0:
                pattern = re.compile(r"^(?P<name>[^\s]+)\s+(?P<old>\S+)\s+->\s+(?P<new>\S+)\s*$")
                for row in result.stdout.splitlines():
                    match = pattern.fullmatch(row.strip())
                    if not match:
                        detail = f"Unexpected checkupdates output: {row[:300]}"
                        break
                    packages.append(match.groupdict())
                if packages and not detail:
                    status = "updates-available"
                elif not detail:
                    detail = "checkupdates reported updates but produced no package rows."
            else:
                detail = (result.stderr.strip() or result.stdout.strip() or f"checkupdates exited {result.returncode}")[:1000]
        if packages and not detail:
            try:
                repositories = isolated_package_repositories(database, [package["name"] for package in packages])
                for package in packages:
                    package["repo"] = repositories[package["name"]]
            except (ConfigError, OSError, subprocess.SubprocessError) as error:
                status = "failed"
                detail = f"Could not resolve candidate repositories from the isolated database: {error}"
        if status in {"up-to-date", "updates-available"}:
            sync_databases = [
                path for path in database.rglob("*.db")
                if path.parent.name == "sync" and path.is_file() and not path.is_symlink()
            ]
            if not sync_databases:
                status = "stale"
                detail = "The isolated sync database freshness could not be established; update availability is unknown."
            else:
                newest_metadata = max(path.stat().st_mtime for path in sync_databases)
                age_hours = max(0, (datetime.now().timestamp() - newest_metadata) / 3600)
                if age_hours > 24:
                    status = "stale"
                    detail = f"The isolated sync metadata is {age_hours:.1f} hours old; update availability is unknown."

    reports = root / "reports"
    if reports.is_symlink():
        raise ConfigError(f"refusing symlinked reports directory: {reports}")
    reports.mkdir(mode=0o700, exist_ok=True)
    if reports.stat().st_uid != os.getuid() or reports.stat().st_mode & 0o077:
        raise ConfigError(f"update reports directory must be private and user-owned: {reports}")
    report_path = reports / (now.strftime("%Y%m%dT%H%M%SZ") + ".md")
    if report_path.is_symlink():
        raise ConfigError(f"refusing symlinked update report: {report_path}")
    lines = [
        "# Hexen package update review", "", f"- Check time: {checked_at}",
        f"- Result: **{status}**",
    ]
    if detail:
        lines.append(f"- Details: {detail}")
    lines.extend([
        "", "Discovery uses checkupdates' separate package database. No packages were downloaded or installed and the system Pacman database was not refreshed.",
        "", "This discovery does not download packages or verify candidate signatures. The confirmed Pacman transaction records signature results in its transcript. A valid package signature establishes the trusted signer for that artifact, not that its source or build is harmless. This report does not compare source/build provenance or package file inventories; those are **not compared**.",
        "", "For official repository packages, review the Arch packaging recipe history and package page.", "",
    ])
    if packages:
        lines.extend(["| Package | Installed | Candidate | Repository | Arch package | Recipe history |", "|---|---:|---:|---|---|---|"])
        for package in packages:
            name, repo = package["name"], package.get("repo", "")
            package_page = f"[package](https://archlinux.org/packages/{repo}/x86_64/{name}/)" if repo else "not resolved"
            lines.append(
                f"| `{name}` | `{package['old']}` | `{package['new']}` | `{repo}` | "
                f"{package_page} | "
                f"[recipe commits](https://gitlab.archlinux.org/archlinux/packaging/packages/{name}/-/commits/main) |"
            )
    elif status == "up-to-date":
        lines.append("No official Arch package updates were listed at this check time.")
    else:
        lines.append("Update availability is unknown because the check did not complete successfully.")
    lines.extend([
        "", "Run `hexen update-monitor review` in a terminal for package-by-package review and an explicit handoff to `hexen update`.",
        "AUR, Flatpak, vendor, AppImage, Walker/Elephant, Neovim plugin, and language-tool updates are outside this Pacman report.", "",
    ])
    content = "\n".join(lines)
    report_path.write_text(content, encoding="utf-8")
    report_path.chmod(0o600)
    latest = root / "latest.md"
    if latest.is_symlink():
        raise ConfigError(f"refusing symlinked latest report path: {latest}")
    latest.write_text(content, encoding="utf-8")
    latest.chmod(0o600)
    append_update_evidence(root, {
        "time": checked_at, "event": "discovery", "status": status,
        "packages": packages, "report": str(report_path), "detail": detail,
    })
    print(f"Update discovery: {status}\nReport: {report_path}")
    if detail:
        print(f"Details: {detail}")

    notifier = shutil.which("notify-send") if notify else None
    if notifier and status in {"updates-available", "failed", "stale"}:
        summary = f"{len(packages)} Arch package update(s) available" if status == "updates-available" else f"Hexen update check: {status}"
        rows = [
            f"{package['name']} {package['old']} → {package['new']} ({package['repo']})"
            for package in packages[:8]
        ]
        if len(packages) > len(rows):
            rows.append(f"and {len(packages) - len(rows)} more; see the full report")
        rows.extend([f"Checked: {checked_at}", f"<a href=\"{report_path.absolute().as_uri()}\">Open full report</a>",
                     "Run `hexen update-monitor review` in a terminal to review and approve a full update."])
        body = "\n".join(rows) if packages else "\n".join([detail, f"Checked: {checked_at}",
                                                               f"<a href=\"{report_path.absolute().as_uri()}\">Open full report</a>"])
        notification = subprocess.run(
            [notifier, "--app-name=Hexen", "--urgency=critical" if status == "failed" else "--urgency=normal",
             summary, body],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        append_update_evidence(root, {
            "time": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "event": "notification", "status": "sent" if notification.returncode == 0 else "unavailable",
            "detail": notification.stderr.strip()[:500],
        })
    elif notify and status in {"updates-available", "failed", "stale"}:
        append_update_evidence(root, {
            "time": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "event": "notification", "status": "unavailable", "detail": "notify-send is not installed",
        })
    return UpdateDiscovery(
        checked_at=checked_at,
        status=status,
        detail=detail,
        report_path=report_path,
        packages=tuple(
            UpdateCandidate(
                name=package["name"], old=package["old"],
                new=package["new"], repo=package.get("repo", ""),
            )
            for package in packages
        ),
        exit_code=0 if status in {"updates-available", "up-to-date"} else 1,
    )


def update_review_links(candidate: UpdateCandidate) -> tuple[str, str]:
    """Return direct official package and recipe-history links for a candidate."""
    package = f"https://archlinux.org/packages/{candidate.repo}/x86_64/{candidate.name}/"
    recipe = f"https://gitlab.archlinux.org/archlinux/packaging/packages/{candidate.name}/-/commits/main"
    return package, recipe


def record_update_review_choice(
    discovery: UpdateDiscovery, candidate: UpdateCandidate, decision: str,
) -> None:
    """Append one package decision to the private update evidence stream."""
    if decision not in {"reviewed", "wanted", "follow-up", "undecided"}:
        raise ConfigError(f"unsupported package review decision: {decision}")
    append_update_evidence(private_update_state(), {
        "time": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "event": "package-review",
        "review_id": discovery.checked_at,
        "report": str(discovery.report_path),
        "package": candidate.name,
        "installed_version": candidate.old,
        "candidate_version": candidate.new,
        "repository": candidate.repo,
        "decision": decision,
    })


def command_update_review(vm_mode: bool = False) -> int:
    """Review discovered packages interactively before optional full update."""
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ConfigError("hexen update-monitor review requires an interactive terminal")

    discovery = command_update_monitor(notify=False)
    if discovery.status != "updates-available":
        if discovery.status == "up-to-date":
            print("No official Arch package updates are available to review.")
        else:
            print(f"Package review was not started: discovery status is {discovery.status}.")
            if discovery.detail:
                print(f"Details: {discovery.detail}")
        return discovery.exit_code

    review = UpdateReviewState(discovery)
    print("\nPackage-by-package review")
    print("Choices record review intent only; Arch updates must use a full system upgrade.")
    for index, candidate in enumerate(discovery.packages, start=1):
        package_page, recipe_history = update_review_links(candidate)
        print(f"\n[{index}/{len(discovery.packages)}] {candidate.name}")
        print(f"  Installed: {candidate.old}")
        print(f"  Candidate: {candidate.new}")
        print(f"  Repository: {candidate.repo}")
        print(f"  Package: {package_page}")
        print(f"  Recipe history: {recipe_history}")
        while True:
            try:
                answer = input(
                    "  [r] reviewed, [w] want in upcoming update, [f] follow up, "
                    "[s] leave undecided, [q] quit review: "
                ).strip().lower()
            except EOFError:
                answer = "q"
            except KeyboardInterrupt:
                review.record_outcome("interrupted")
                print("\nReview interrupted. Completed package choices were saved; no update was started.")
                return 130
            choices = {
                "r": "reviewed", "w": "wanted", "f": "follow-up", "s": "undecided",
            }
            if answer in choices:
                decision = choices[answer]
                review.record_choice(candidate, decision)
                print(f"  Recorded: {decision}")
                break
            if answer == "q":
                review.record_outcome("interrupted")
                print("Review stopped. Completed package choices were saved; no update was started.")
                return 0
            print("Choose r, w, f, s, or q.")

    print("\nReview summary")
    for candidate in discovery.packages:
        print(f"  {candidate.name}: {review.decisions.get(candidate.name, 'undecided')}")
    print("\nThe choices do not filter Pacman. Continuing starts the full-system update workflow,")
    print("which has its own confirmation, source review, and recovery checkpoint.")
    while True:
        try:
            answer = input("Continue to the full update workflow? [y/N] ").strip().lower()
        except EOFError:
            answer = ""
        except KeyboardInterrupt:
            review.record_outcome("interrupted")
            print("\nReview interrupted. Completed package choices were saved; no update was started.")
            return 130
        if answer in {"y", "yes"}:
            decision = "handoff-to-full-update"
            break
        if answer in {"", "n", "no"}:
            decision = "cancelled"
            break
        print("Enter y to continue or n to cancel.")

    review.record_outcome(decision)
    if decision == "cancelled":
        print("Update cancelled; no package changes were made.")
        return 0
    return command_update(vm_mode)


def package_manifest_inventory(before: str, after: str, directory: Path) -> list[dict[str, str]]:
    """Write package deltas and cache metadata without claiming unavailable comparisons."""
    def parse_manifest(value: str) -> dict[str, str]:
        parsed: dict[str, str] = {}
        for row in value.splitlines():
            columns = row.split(None, 1)
            if len(columns) == 2:
                parsed[columns[0]] = columns[1]
        return parsed

    old, new = parse_manifest(before), parse_manifest(after)
    changes = [
        {"name": name, "old_version": old.get(name, ""), "new_version": new.get(name, ""),
         "change": "added" if name not in old else "removed" if name not in new else "updated",
         "repository": "see update.log Pacman transaction transcript",
         "signature": "see update.log Pacman transaction transcript; review package signer result",
         "provenance": "not compared; inspect Arch packaging recipe and upstream source"}
        for name in sorted(old.keys() | new.keys()) if old.get(name) != new.get(name)
    ]
    (directory / "package-changes.json").write_text(json.dumps(changes, indent=2) + "\n", encoding="utf-8")
    (directory / "package-changes.json").chmod(0o600)
    cache = Path("/var/cache/pacman/pkg")
    bsdtar = shutil.which("bsdtar")
    for item in changes:
        name = item["name"]
        for side, version in (("old", item["old_version"]), ("new", item["new_version"])):
            if not version:
                continue
            matches = sorted(
                path for path in cache.glob(f"{name}-{version}-*.pkg.tar.*")
                if path.is_file() and not path.is_symlink() and not path.name.endswith(".sig")
            ) if cache.is_dir() else []
            if not matches or not bsdtar:
                item[f"{side}_artifact"] = "not available in package cache; not compared"
                continue
            archive = matches[-1]
            artifact_info: dict[str, str] = {"path": str(archive), "sha256": ""}
            digest = hashlib.sha256()
            with archive.open("rb") as stream:
                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                    digest.update(chunk)
            artifact_info["sha256"] = digest.hexdigest()
            for member in (".PKGINFO", ".BUILDINFO"):
                extracted = subprocess.run(
                    [bsdtar, "-xOf", str(archive), member], text=True,
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
                )
                if extracted.returncode == 0:
                    target = directory / f"{name}-{version}-{member[1:]}.txt"
                    target.write_text(extracted.stdout, encoding="utf-8")
                    target.chmod(0o600)
                    artifact_info[member] = str(target.name)
            listing = subprocess.run(
                [bsdtar, "-tf", str(archive)], text=True, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, check=False,
            )
            if listing.returncode == 0:
                target = directory / f"{name}-{version}-files.txt"
                target.write_text(listing.stdout, encoding="utf-8")
                target.chmod(0o600)
                artifact_info["file_inventory"] = str(target.name)
            item[f"{side}_artifact"] = json.dumps(artifact_info, sort_keys=True)
        if not ("file_inventory" in item.get("old_artifact", "") and "file_inventory" in item.get("new_artifact", "")):
            item["file_diff"] = "not compared; both old and new package archives were not available"
        else:
            old_file = directory / f"{name}-{item['old_version']}-files.txt"
            new_file = directory / f"{name}-{item['new_version']}-files.txt"
            old_rows = set(old_file.read_text(encoding="utf-8").splitlines())
            new_rows = set(new_file.read_text(encoding="utf-8").splitlines())
            item["file_diff"] = json.dumps({"added": sorted(new_rows - old_rows), "removed": sorted(old_rows - new_rows)})
    (directory / "package-changes.json").write_text(json.dumps(changes, indent=2) + "\n", encoding="utf-8")
    (directory / "package-changes.json").chmod(0o600)
    return changes


def command_migrate() -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ConfigError("hexen migrate requires an interactive terminal")
    if os.geteuid() == 0:
        raise ConfigError("hexen migrate must be run as the logged-in user, without sudo")
    migrations = load_migrations()
    if not migrations:
        print("No Hexen user migrations are defined.")
        return 0
    state = migration_state_root()
    pending = pending_migrations(state, migrations)
    if not pending:
        print("No pending Hexen user migrations.")
        return 0
    print("Pending user migrations:")
    for migration in pending:
        print(f"  {migration['id']}: {migration['description']}")
    log_dir = state / "logs"
    if log_dir.is_symlink():
        raise ConfigError(f"refusing symlinked migration log directory: {log_dir}")
    log_dir.mkdir(mode=0o700, exist_ok=True)
    log_info = log_dir.stat()
    if log_info.st_uid != os.getuid() or log_info.st_mode & 0o077:
        raise ConfigError(f"migration log directory must be private and user-owned: {log_dir}")
    now = datetime.now(timezone.utc)
    log = log_dir / (now.strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(4) + ".log")
    log.touch(mode=0o600)
    print(f"Migration log: {log}")
    try:
        answer = input("Run these migrations as the current user? [y/N] ").strip().lower()
    except EOFError as error:
        raise ConfigError("confirmation input closed; no migrations were run") from error
    if answer not in {"y", "yes"}:
        print("Migration run cancelled.")
        return 0
    completed, remaining = run_migrations(log)
    print(f"Completed {completed} migration(s); {remaining} remain pending.")
    return 1 if remaining else 0
def update_capture(argv: list[str], log: Path) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(argv, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    update_log(log, "$ " + shlex.join(argv))
    if result.stdout:
        update_log(log, result.stdout)
    if result.stderr:
        update_log(log, result.stderr)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit status {result.returncode}"
        raise ConfigError(f"command failed: {shlex.join(argv)}: {detail}")
    return result


def update_capture_archive(argv: list[str], output: Path, log: Path) -> None:
    """Run a privileged archive producer into a private user-owned file."""
    partial = output.with_name(output.name + ".partial")
    if partial.is_symlink() or partial.exists() or output.is_symlink() or output.exists():
        raise ConfigError(f"refusing to overwrite an existing boot archive path: {output}")
    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "wb") as archive:
            fd = -1
            update_log(log, "$ " + shlex.join(argv))
            result = subprocess.run(argv, stdout=archive, stderr=subprocess.PIPE, check=False)
            archive.flush()
            os.fsync(archive.fileno())
    finally:
        if fd >= 0:
            os.close(fd)
    error = result.stderr.decode(errors="replace").strip()
    if error:
        update_log(log, error)
    if result.returncode:
        detail = error or f"exit status {result.returncode}"
        raise ConfigError(f"command failed: {shlex.join(argv)}: {detail}")
    os.replace(partial, output)
    directory_fd = os.open(output.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def update_checkpoint_root() -> Path:
    home = Path.home()
    recovery = home / "recovery"
    root = recovery / "hexen-updates"
    if recovery.is_symlink() or root.is_symlink():
        raise ConfigError("refusing to create update checkpoints through a symlink")
    try:
        recovery.mkdir(mode=0o700, exist_ok=True)
    except PermissionError:
        return private_update_checkpoint_root()
    recovery_info = recovery.stat()
    if not recovery.is_dir() or recovery_info.st_uid not in {0, os.getuid()} or recovery_info.st_mode & 0o022:
        raise ConfigError(f"update recovery parent must be a real, non-group/world-writable directory: {recovery}")
    if not root.exists():
        try:
            root.mkdir(mode=0o700)
        except PermissionError:
            return private_update_checkpoint_root()
    return validate_update_checkpoint_root(root)


def validate_update_checkpoint_root(root: Path) -> Path:
    if root.is_symlink():
        raise ConfigError(f"refusing symlinked update checkpoint directory: {root}")
    info = root.stat()
    if not root.is_dir() or info.st_uid != os.getuid():
        raise ConfigError(f"update checkpoint directory must be owned by this user: {root}")
    if info.st_mode & 0o077:
        raise ConfigError(f"update checkpoint directory must be private (mode 0700): {root}")
    if info.st_mode & 0o700 != 0o700:
        raise ConfigError(f"update checkpoint directory must be writable by this user: {root}")
    return root


def private_update_checkpoint_root() -> Path:
    """Use private Hexen state when ~/recovery cannot hold user checkpoints."""
    root = private_update_state() / "checkpoints"
    if root.is_symlink():
        raise ConfigError(f"refusing symlinked update checkpoint directory: {root}")
    root.mkdir(mode=0o700, exist_ok=True)
    return validate_update_checkpoint_root(root)


def ensure_no_pacman_lock() -> None:
    lock = Path("/var/lib/pacman/db.lck")
    if lock.exists() or lock.is_symlink():
        raise ConfigError(f"Pacman database lock exists; inspect for an active package operation: {lock}")


def refresh_repository(log: Path) -> tuple[str, str, bool]:
    """Fetch the configured upstream and offer only a reviewed fast-forward."""
    current = repo_git("rev-parse", "HEAD")
    branch = repo_git("symbolic-ref", "--quiet", "--short", "HEAD")
    if current.returncode or branch.returncode:
        update_log(log, "Source update skipped: checkout is detached or its revision is unavailable.")
        print("Source update skipped because this checkout has no current branch.")
        return current.stdout.strip(), current.stdout.strip(), False

    old_revision = current.stdout.strip()
    remote = repo_git("config", "--get", f"branch.{branch.stdout.strip()}.remote")
    if remote.returncode or not remote.stdout.strip():
        update_log(log, "Source update skipped: current branch has no configured remote.")
        print("Source update skipped; no remote is configured for this branch.")
        return old_revision, old_revision, False

    remote_name = remote.stdout.strip()
    if remote_name != ".":
        update_log(log, "Fetching the configured source remote; remote URL and credential output are omitted from the log.")
        print("Fetching the configured source remote…")
        fetched = subprocess.run(
            ["git", "--no-pager", "-C", str(REPO_ROOT), "-c", "core.hooksPath=/dev/null",
             "fetch", "--no-tags", remote_name],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        if fetched.returncode:
            raise ConfigError(f"Git fetch failed (status {fetched.returncode}); source files were not changed")
        update_log(log, "Configured source remote fetch completed.")

    upstream = repo_git("rev-parse", "--symbolic-full-name", "@{upstream}")
    if upstream.returncode:
        raise ConfigError(upstream.stderr.strip() or "cannot resolve the configured upstream after fetch")
    target = upstream.stdout.strip()
    counts = repo_git("rev-list", "--left-right", "--count", f"HEAD...{target}")
    if counts.returncode:
        raise ConfigError(counts.stderr.strip() or "cannot compare source branch with its upstream")
    ahead, behind = (int(value) for value in counts.stdout.split())
    if ahead and behind:
        raise ConfigError(f"source branch has diverged from {target}; reconcile it manually before updating")
    if not behind:
        update_log(log, f"Source is already current at {old_revision} (ahead {ahead}, behind 0).")
        print(f"Source checkout is current relative to {target} (ahead {ahead}, behind 0).")
        return old_revision, old_revision, False

    commits = repo_git("log", "--oneline", "--decorate=no", f"HEAD..{target}")
    stat = repo_git("diff", "--stat", "--no-ext-diff", "--no-color", "HEAD", target)
    diff = repo_git("diff", "--no-ext-diff", "--no-color", "HEAD", target)
    if any(result.returncode for result in (commits, stat, diff)):
        raise ConfigError("cannot display all incoming source changes; no fast-forward was performed")
    summary = (
        f"Incoming commits from {target}:\n{commits.stdout.strip()}\n\n"
        f"Change summary:\n{stat.stdout.strip()}\n\n"
        "Full source diff follows:\n" + diff.stdout
    )
    print(summary)
    update_log(log, summary)
    print("A fast-forward changes the checked-out source immediately, including any linked desktop config files.")
    try:
        answer = input(f"Fast-forward {branch.stdout.strip()} to {target}? [y/N] ").strip().lower()
    except EOFError as error:
        raise ConfigError("confirmation input closed; source was not fast-forwarded") from error
    if answer not in {"y", "yes"}:
        update_log(log, "Source fast-forward declined; proceeding with the current clean checkout.")
        print("Source remains at its current revision; package update may continue without config changes.")
        return old_revision, old_revision, False

    status = repo_git("status", "--porcelain=v1", "--untracked-files=normal")
    if status.returncode or status.stdout:
        raise ConfigError("source checkout changed during review; fast-forward was not attempted")
    merged = repo_git("-c", "core.hooksPath=/dev/null", "merge", "--ff-only", target)
    if merged.returncode:
        raise ConfigError(merged.stderr.strip() or "clean source fast-forward failed")
    new_revision = repo_git("rev-parse", "HEAD")
    clean = repo_git("status", "--porcelain=v1", "--untracked-files=normal")
    if new_revision.returncode or clean.returncode or clean.stdout:
        raise ConfigError("source fast-forward result could not be verified as clean")
    new_revision_id = new_revision.stdout.strip()
    update_log(log, f"Source fast-forward completed: {old_revision} -> {new_revision_id}")
    print(f"Source fast-forwarded: {old_revision[:12]} -> {new_revision_id[:12]}")
    print(f"If you need to restore the prior source, its revision is recorded in {log.parent / 'source-revisions.txt'}.")
    return old_revision, new_revision_id, True


def command_update(vm_mode: bool = False) -> int:
    """Run an explicitly confirmed Pacman update with a recovery checkpoint."""
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ConfigError("hexen update requires an interactive terminal")
    for tool in (
        "sudo", "snapper", "tar", "findmnt", "btrfs", "pacman", "script",
        "find", "sha256sum", "sync", "systemctl",
    ):
        if not shutil.which(tool):
            raise ConfigError(f"required update tool is missing: {tool}")

    checkpoint_root = update_checkpoint_root()
    lock_path = checkpoint_root / ".update.lock"
    if lock_path.is_symlink():
        raise ConfigError(f"refusing symlinked update lock: {lock_path}")
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    lock_info = os.fstat(lock_fd)
    if lock_info.st_uid != os.getuid() or lock_info.st_mode & 0o077:
        os.close(lock_fd)
        raise ConfigError(f"update lock must be private and user-owned: {lock_path}")
    checkpoint: Path | None = None
    log: Path | None = None
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ConfigError("another Hexen update is already running") from error

        now = datetime.now(timezone.utc)
        checkpoint = checkpoint_root / (now.strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(4))
        checkpoint.mkdir(mode=0o700)
        checkpoint_mode = checkpoint.stat().st_mode
        if checkpoint_mode & 0o077 or checkpoint_mode & 0o700 != 0o700:
            raise ConfigError(f"update run directory must be private and user-writable: {checkpoint}")
        log = checkpoint / "update.log"
        log.touch(mode=0o600)
        log.chmod(0o600)
        revision_result = repo_git("rev-parse", "HEAD")
        if revision_result.returncode:
            raise ConfigError(revision_result.stderr.strip() or "cannot read source revision")
        revision = revision_result.stdout.strip()
        update_log(log, f"Hexen update started {now.isoformat()}\nSource revision: {revision}")

        ensure_no_pacman_lock()

        git_status = repo_git("status", "--porcelain=v1", "--untracked-files=normal")
        if git_status.returncode:
            raise ConfigError(git_status.stderr.strip() or "cannot inspect repository before update")
        if git_status.stdout:
            changes = "\n".join(f"  {line}" for line in git_status.stdout.splitlines())
            raise ConfigError("repository has local changes; review or commit them before updating:\n" + changes)
        upstream = repo_git("rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
        if upstream.returncode == 0:
            counts = repo_git("rev-list", "--left-right", "--count", f"HEAD...{upstream.stdout.strip()}")
            if counts.returncode:
                raise ConfigError(counts.stderr.strip() or "cannot compare repository with cached upstream")
            ahead, behind = (int(value) for value in counts.stdout.split())
            if ahead and behind:
                raise ConfigError("repository has diverged from cached upstream; reconcile it manually before updating")

        root_type = subprocess.run(["findmnt", "-n", "-o", "FSTYPE", "/"], text=True,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        root_fsroot = subprocess.run(["findmnt", "-n", "-o", "FSROOT", "--mountpoint", "/"], text=True,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        home_type = subprocess.run(["findmnt", "-n", "-o", "FSTYPE", "--target", str(Path.home())], text=True,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        home_fsroot = subprocess.run(["findmnt", "-n", "-o", "FSROOT", "--target", str(Path.home())], text=True,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        boot_type = subprocess.run(["findmnt", "-n", "-o", "FSTYPE", "--mountpoint", "/boot"], text=True,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        if root_type.returncode or root_type.stdout.strip() != "btrfs":
            raise ConfigError("update checkpoint requires the supported Btrfs root filesystem")
        if (root_fsroot.returncode or home_type.returncode or home_fsroot.returncode
                or home_type.stdout.strip() != "btrfs"
                or home_fsroot.stdout.strip() == root_fsroot.stdout.strip()):
            raise ConfigError("update checkpoint requires /home on a separate Btrfs subvolume")
        if boot_type.returncode or boot_type.stdout.strip().lower() not in {"vfat", "fat", "fat32"}:
            raise ConfigError("update checkpoint requires a mounted FAT ESP at /boot")
        if not Path("/etc/snapper/configs/root").is_file():
            raise ConfigError("Snapper root configuration is missing")

        boot_bytes = sum(path.stat().st_size for path in Path("/boot").rglob("*") if path.is_file())
        checkpoint_free = shutil.disk_usage(checkpoint_root).free
        boot_free = shutil.disk_usage("/boot").free
        reserve = 64 * 1024 * 1024
        if checkpoint_free < boot_bytes + reserve:
            raise ConfigError("not enough free space under /home for the matching /boot archive")
        if boot_free < max(reserve, boot_bytes):
            raise ConfigError("not enough free space on /boot for a kernel/initramfs update")

        root_free = shutil.disk_usage("/").free
        print(f"Checkpoint directory: {checkpoint}")
        print(f"Free space: root {root_free // (1024**3)} GiB; /home {checkpoint_free // (1024**3)} GiB; /boot {boot_free // (1024**2)} MiB")
        print("After confirmation, Hexen fetches the configured Git remote, shows any incoming commits/diff, then asks separately before a fast-forward.")
        print("It then creates a permanent Snapper root snapshot, archives /boot, and runs sudo pacman -Syu.")
        print("The root snapshot does not include /home. Keep this archive and snapshot together; they are not an off-device backup.")
        print("Close other package managers first; Hexen checks Pacman's lock but does not block other package tools.")
        try:
            answer = input("Continue with the update? [y/N] ").strip().lower()
        except EOFError as error:
            raise ConfigError("confirmation input closed; no checkpoint or package update was made") from error
        if answer not in {"y", "yes"}:
            update_log(log, "Update cancelled before snapshot creation.")
            try:
                append_update_evidence(private_update_state(), {
                    "time": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                    "event": "owner-review", "decision": "declined", "checkpoint": str(checkpoint),
                })
            except (ConfigError, OSError) as error:
                update_log(log, f"Owner decision evidence could not be saved: {error}")
            print("Update cancelled; no snapshot or package transaction was made.")
            return 0
        try:
            append_update_evidence(private_update_state(), {
                "time": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                "event": "owner-review", "decision": "approved-update-workflow", "checkpoint": str(checkpoint),
            })
        except (ConfigError, OSError) as error:
            update_log(log, f"Owner decision evidence could not be saved: {error}")

        source_before, source_after, source_changed = refresh_repository(log)
        (checkpoint / "source-revisions.txt").write_text(
            f"before {source_before}\nafter  {source_after}\n", encoding="ascii"
        )
        ensure_no_pacman_lock()
        packages_before = update_capture(["pacman", "-Q"], log).stdout
        (checkpoint / "packages-before.txt").write_text(packages_before, encoding="utf-8")
        (checkpoint / "mounts.json").write_text(
            update_capture(["findmnt", "--json"], log).stdout, encoding="utf-8"
        )
        (checkpoint / "subvolumes.txt").write_text(
            update_capture(["sudo", "btrfs", "subvolume", "list", "/"], log).stdout,
            encoding="utf-8",
        )
        update_capture_archive(["sudo", "tar", "-C", "/boot", "-cpf", "-", "."], checkpoint / "boot.tar", log)
        boot_hashes = update_capture(["sudo", "find", "/boot", "-type", "f", "-exec", "sha256sum", "{}", "+"], log)
        (checkpoint / "boot.sha256").write_text(boot_hashes.stdout, encoding="utf-8")
        archive_hash = update_capture(["sha256sum", str(checkpoint / "boot.tar")], log)
        (checkpoint / "boot.tar.sha256").write_text(archive_hash.stdout, encoding="utf-8")
        ensure_no_pacman_lock()
        snapshot = update_capture(
            ["sudo", "snapper", "-c", "root", "create", "--type", "single",
             "--description", f"hexen-before-update-{now.strftime('%Y%m%dT%H%M%SZ')}",
             "--userdata", "important=yes", "--print-number"], log,
        ).stdout.strip()
        if not snapshot.isdigit():
            raise ConfigError("Snapper did not return a snapshot number; refusing to run Pacman")
        (checkpoint / "snapshot-number").write_text(snapshot + "\n", encoding="ascii")
        ensure_no_pacman_lock()
        packages_at_snapshot = update_capture(["pacman", "-Q"], log).stdout
        if packages_at_snapshot != packages_before:
            raise ConfigError("installed package set changed while the recovery checkpoint was being created")
        (checkpoint / "packages-at-snapshot.txt").write_text(packages_at_snapshot, encoding="utf-8")
        update_capture(["sync"], log)
        print(f"Recovery checkpoint ready: Snapper snapshot {snapshot} and {checkpoint / 'boot.tar'}")

        ensure_no_pacman_lock()
        pacman_command = shlex.join(["sudo", "pacman", "-Syu"])
        update_log(log, "$ sudo pacman -Syu (interactive transcript follows)")
        transaction = subprocess.run(
            ["script", "--quiet", "--flush", "--return", "--append", "--command", pacman_command, str(log)],
            check=False,
        )
        if transaction.returncode:
            update_log(log, f"Pacman transaction failed with status {transaction.returncode}")
            try:
                append_update_evidence(private_update_state(), {
                    "time": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                    "event": "update-result", "status": "failed", "exit_status": transaction.returncode,
                    "checkpoint": str(checkpoint),
                })
            except (ConfigError, OSError) as error:
                update_log(log, f"Update result evidence could not be saved: {error}")
            print(f"Update failed with status {transaction.returncode}; checkpoint retained at {checkpoint}")
            return transaction.returncode or 1

        update_log(log, "Pacman transaction completed successfully; post-update inspection follows.")
        try:
            append_update_evidence(private_update_state(), {
                "time": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                "event": "update-result", "status": "applied", "checkpoint": str(checkpoint),
            })
        except (ConfigError, OSError) as error:
            update_log(log, f"Update result evidence could not be saved: {error}")
        after = update_capture(["pacman", "-Q"], log)
        (checkpoint / "packages-after.txt").write_text(after.stdout, encoding="utf-8")
        try:
            package_manifest_inventory(packages_before, after.stdout, checkpoint)
        except (OSError, UnicodeError, subprocess.SubprocessError) as error:
            update_log(log, f"Package provenance inventory incomplete; unavailable evidence is not compared: {error}")
            (checkpoint / "package-changes-status.txt").write_text(
                f"incomplete; inspect update.log; unavailable provenance is not compared: {error}\n", encoding="utf-8"
            )
        effective_package_manifest = after.stdout
        migrations_pending = False
        migration_problem = False
        try:
            migrations = load_migrations()
            if migrations:
                state = migration_state_root()
                pending = pending_migrations(state, migrations)
                if pending:
                    migrations_pending = True
                    print("Pending user migrations:")
                    for migration in pending:
                        print(f"  {migration['id']}: {migration['description']}")
                    try:
                        answer = input("Run these migrations as the current user now? [y/N] ").strip().lower()
                    except EOFError:
                        answer = ""
                    if answer in {"y", "yes"}:
                        completed, remaining = run_migrations(log)
                        migrations_pending = remaining > 0
                        migration_problem = remaining > 0
                        update_log(log, f"Post-update migrations: {completed} completed, {remaining} pending.")
                    else:
                        update_log(log, "Post-update migrations declined; they remain pending for `hexen migrate`.")
                        print("Migrations remain pending; run `hexen migrate` after reviewing this update.")
        except (ConfigError, OSError, UnicodeError) as error:
            migration_problem = True
            migrations_pending = True
            update_log(log, f"Post-update migrations could not be inspected or run: {error}")
            print(f"Migrations could not be inspected or run: {error}")
        pacnew = update_capture(
            ["find", "/etc", "-type", "f", "(", "-name", "*.pacnew", "-o", "-name", "*.pacsave", ")", "-print"],
            log,
        )
        failed_units = update_capture(["systemctl", "--failed", "--no-legend", "--plain"], log)
        (checkpoint / "pacnew-pacsave.txt").write_text(pacnew.stdout, encoding="utf-8")
        (checkpoint / "failed-units.txt").write_text(failed_units.stdout, encoding="utf-8")
        running_modules = Path("/usr/lib/modules") / os.uname().release
        try:
            uptime = float(Path("/proc/uptime").read_text(encoding="ascii").split()[0])
            boot_time = datetime.now().timestamp() - uptime
            newer_modules = [
                path.name for path in running_modules.parent.iterdir()
                if path.is_dir() and path != running_modules and path.stat().st_mtime > boot_time
            ] if running_modules.is_dir() else []
            reboot_signal = (
                "possible reboot pending: running kernel module tree is missing"
                if not running_modules.is_dir()
                else "possible kernel reboot pending: " + ", ".join(sorted(newer_modules))
                if newer_modules
                else "no kernel reboot signal detected; service-level restart needs are not checked"
            )
        except (OSError, ValueError, IndexError) as error:
            reboot_signal = f"kernel reboot status unavailable: {error}"
        (checkpoint / "reboot-status.txt").write_text(reboot_signal + "\n", encoding="utf-8")
        print(f"System package update completed. Log and recovery checkpoint: {checkpoint}")
        if pacnew.stdout.strip():
            print("Review .pacnew/.pacsave candidates listed in pacnew-pacsave.txt.")
        if failed_units.stdout.strip():
            print("Failed system units were recorded in failed-units.txt; review them before relying on the system.")
        print(f"Reboot check: {reboot_signal}")
        convergence_status = "declined-before-preview"
        convergence_failed = False
        if not migrations_pending and not migration_problem:
            try:
                answer = input("Review Ansible configuration convergence now? [y/N] ").strip().lower()
            except EOFError:
                answer = ""
            if answer in {"y", "yes"}:
                convergence_log = checkpoint / "provisioner.log"
                convergence_status = "completed"
                update_log(log, f"Starting reviewed Ansible convergence (VM mode: {vm_mode}).")
                try:
                    result_code = command_apply(vm_mode, review=True, log=convergence_log)
                    if result_code == 3:
                        convergence_status = "declined-or-cancelled"
                    elif result_code:
                        convergence_status = f"failed-{result_code}"
                        convergence_failed = True
                    update_log(log, f"Ansible convergence result: {convergence_status}; transcript: {convergence_log}")
                except (ConfigError, OSError) as error:
                    convergence_status = f"could-not-start: {error}"
                    convergence_failed = True
                    update_log(log, f"Ansible convergence could not start: {error}")

                post_units = None
                try:
                    post_packages = update_capture(["pacman", "-Q"], log)
                    (checkpoint / "packages-after-convergence.txt").write_text(post_packages.stdout, encoding="utf-8")
                    effective_package_manifest = post_packages.stdout
                    post_units = update_capture(["systemctl", "--failed", "--no-legend", "--plain"], log)
                    (checkpoint / "failed-units-after-convergence.txt").write_text(post_units.stdout, encoding="utf-8")
                except (ConfigError, OSError, UnicodeError) as error:
                    convergence_failed = True
                    convergence_status += "+post-check-failed"
                    update_log(log, f"Post-convergence inspection failed: {error}")
                    print(f"Post-convergence inspection failed: {error}")
                if post_units and post_units.stdout.strip():
                    print("Failed system units after convergence were recorded in failed-units-after-convergence.txt.")
        else:
            convergence_status = "skipped-pending-migrations"
            update_log(log, "Ansible convergence skipped because user migrations remain pending or failed.")
        (checkpoint / "convergence-status.txt").write_text(convergence_status + "\n", encoding="utf-8")
        print(f"Ansible convergence: {convergence_status}")
        source_checks = source_status_lines(effective_package_manifest)
        (checkpoint / "source-checks.txt").write_text("\n".join(source_checks) + "\n", encoding="utf-8")
        update_log(log, "Application source checks:\n" + "\n".join(source_checks))
        for line in source_checks:
            print(line)
        service_status, service_failed = offer_service_restart_review(log)
        (checkpoint / "service-check-status.txt").write_text(service_status + "\n", encoding="utf-8")
        try:
            final_units = update_capture(["systemctl", "--failed", "--no-legend", "--plain"], log)
            (checkpoint / "failed-units-final.txt").write_text(final_units.stdout, encoding="utf-8")
            if final_units.stdout.strip():
                print("Failed units after service review are recorded in failed-units-final.txt.")
        except (ConfigError, OSError, UnicodeError) as error:
            service_failed = True
            update_log(log, f"Final service-state capture failed: {error}")
            print(f"Final service-state capture failed: {error}")
        print("No reboot was performed. Review service-restart-review.log and failed-units-final.txt; if Ansible ran, also review provisioner.log. Manual application sources remain separate.")
        if migrations_pending:
            print("User migrations remain pending; run `hexen migrate` after reviewing the package update.")
        if not source_changed:
            print("No repository fast-forward was applied during this update.")
        return 1 if migration_problem or migrations_pending or convergence_failed or service_failed else 0
    except ConfigError as error:
        if log is not None and checkpoint is not None:
            update_log(log, f"Update stopped before completion: {error}")
            print(f"Update stopped; inspect the log and any partial checkpoint at {checkpoint}")
        raise
    finally:
        os.close(lock_fd)


def command_diff() -> int:
    status = repo_git("status", "--short", "--untracked-files=normal")
    if status.returncode:
        raise ConfigError(status.stderr.strip() or "cannot read repository status")
    print("Repository changes:")
    print(status.stdout.rstrip() if status.stdout else "  clean")

    for title, args in (
        ("Staged changes", ("diff", "--cached", "--no-ext-diff")),
        ("Unstaged changes", ("diff", "--no-ext-diff")),
    ):
        result = repo_git(*args)
        if result.returncode:
            raise ConfigError(result.stderr.strip() or f"cannot show {title.lower()}")
        print(f"\n{title}:")
        print(result.stdout.rstrip() if result.stdout else "  none")

    untracked = repo_git("ls-files", "--others", "--exclude-standard", "-z")
    if untracked.returncode:
        raise ConfigError(untracked.stderr.strip() or "cannot list untracked repository files")
    print("\nUntracked file contents:")
    paths = [path for path in untracked.stdout.split("\0") if path]
    if not paths:
        print("  none")
    for relative in paths:
        path = REPO_ROOT / relative
        if path.is_symlink() or not path.is_file() or not path.resolve().is_relative_to(REPO_ROOT):
            print(f"  skipped unsafe or non-regular path: {relative}")
            continue
        result = subprocess.run(
            ["git", "--no-pager", "-C", str(REPO_ROOT), "diff", "--no-index",
             "--no-ext-diff", "--", "/dev/null", str(path)],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            env={**os.environ, "GIT_PAGER": "cat", "PAGER": "cat"},
        )
        if result.returncode not in {0, 1}:
            raise ConfigError(result.stderr.strip() or f"cannot show untracked file: {relative}")
        print(result.stdout.rstrip() or f"  {relative}: no text diff available")
    return 0


def command_apply(vm_mode: bool, review: bool = False, log: Path | None = None) -> int:
    provisioner = REPO_ROOT / "install/provision.sh"
    if provisioner.is_symlink() or not provisioner.is_file() or not os.access(provisioner, os.X_OK):
        raise ConfigError(f"checked provisioner is missing or unsafe: {provisioner}")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ConfigError("config apply requires an interactive terminal")
    if review:
        help_result = subprocess.run(
            [str(provisioner), "--help"], text=True, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, check=False,
        )
        if help_result.returncode or "--review" not in help_result.stdout:
            raise ConfigError("the checked provisioner does not support reviewed convergence")

    profile = local_setting(PROFILE_RE, "common")
    if profile not in PROFILES:
        raise ConfigError(f"unknown machine profile in local.yml: {profile!r}")
    mode = "VM" if vm_mode else "workstation"
    revision = repo_git("rev-parse", "--short", "HEAD")
    if revision.returncode:
        raise ConfigError(revision.stderr.strip() or "cannot read repository revision")
    changes = repo_git("status", "--short", "--untracked-files=normal")
    if changes.returncode:
        raise ConfigError(changes.stderr.strip() or "cannot read repository status")

    print(f"Configuration target: {mode}")
    print(f"Machine profile: {profile}")
    print(f"Source revision: {revision.stdout.strip()} ({'dirty' if changes.stdout else 'clean'})")
    if changes.stdout:
        print("Working-tree changes that the provisioner will use:")
        for line in changes.stdout.splitlines():
            print(f"  {line}")
    if review:
        print("The provisioner will run an advisory Ansible check/diff and ask again before applying.")
    else:
        print("The provisioner will show its impact summary and ask before applying.")
    print("Use Ctrl+C to stop before or during the interactive process.\n")
    command = [str(provisioner)]
    if vm_mode:
        command.append("--vm")
    if review:
        command.append("--review")
    if log is None:
        return subprocess.run(command, cwd=REPO_ROOT, check=False).returncode
    result = subprocess.run(
        ["script", "--quiet", "--flush", "--return", "--append", "--command",
         shlex.join(command), str(log)],
        cwd=REPO_ROOT,
        check=False,
    )
    return result.returncode


BACKUP_ID_RE = re.compile(r"^\d{8}T\d{6}Z-[0-9a-f]{8}$")


def backup_root(create: bool = True) -> Path:
    home = Path.home()
    state_home = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")).expanduser()
    if not state_home.is_absolute() or state_home.resolve(strict=False) != state_home:
        raise ConfigError("XDG_STATE_HOME must be absolute and contain no symlinked components")
    root = state_home / "hexen/backups/config"
    for parent in (state_home, state_home / "hexen", state_home / "hexen/backups", root):
        if parent.is_symlink():
            raise ConfigError(f"refusing to use symlinked backup directory: {parent}")
        if parent.exists() and not parent.is_dir():
            raise ConfigError(f"backup path is not a directory: {parent}")
    if create:
        root.mkdir(mode=0o700, parents=True, exist_ok=True)
    elif not root.is_dir():
        raise ConfigError(f"no config backups found under: {root}")
    info = root.stat()
    if info.st_uid != os.getuid():
        raise ConfigError(f"backup directory is not owned by this user: {root}")
    if create:
        root.chmod(0o700)
    elif info.st_mode & 0o077:
        raise ConfigError(f"backup directory is accessible by other users: {root}")
    return root


def backup_source(value: str) -> tuple[Path, str]:
    home = Path.home()
    supplied = Path(value).expanduser()
    if supplied.is_absolute():
        candidate = supplied
    elif supplied.parts and supplied.parts[0] == "config":
        candidate = REPO_ROOT / supplied
    elif supplied.parts and supplied.parts[0] == ".config":
        candidate = home / supplied
    else:
        candidate = home / ".config" / supplied

    repo_config = REPO_ROOT / "config"
    home_config = home / ".config"
    if home_config.is_symlink():
        raise ConfigError(f"refusing to back up through a symlinked config root: {home_config}")
    if not candidate.exists() and not candidate.is_symlink():
        raise ConfigError(f"config path does not exist: {candidate}")
    resolved = candidate.resolve(strict=True)
    if resolved == repo_config or resolved == home_config:
        raise ConfigError("back up a file or subdirectory inside config/, not the entire root")
    if resolved.is_relative_to(repo_config):
        origin = "repo:" + resolved.relative_to(REPO_ROOT).as_posix()
    elif resolved.is_relative_to(home_config):
        origin = "home:" + resolved.relative_to(home).as_posix()
    else:
        raise ConfigError("backup source must resolve inside the repository config/ or ~/.config/")
    if not (resolved.is_file() or resolved.is_dir()):
        raise ConfigError(f"backup source must be a regular file or directory: {resolved}")
    return resolved, origin


def command_backup(value: str) -> int:
    source, origin = backup_source(value)
    root = backup_root()
    backup_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(4)
    destination = root / backup_id
    if destination.exists() or destination.is_symlink():
        raise ConfigError(f"backup ID already exists; refusing to replace it: {backup_id}")
    stage = Path(tempfile.mkdtemp(prefix=".pending-", dir=root))
    try:
        payload = stage / "payload"
        if source.is_dir():
            shutil.copytree(source, payload, symlinks=True, copy_function=shutil.copy2)
            kind = "directory"
        else:
            shutil.copy2(source, payload)
            kind = "file"
        manifest = {
            "version": 1,
            "id": backup_id,
            "source": origin,
            "kind": kind,
            "created_at": datetime.now(timezone.utc).isoformat(),
        }
        manifest_path = stage / "manifest.json"
        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
        manifest_path.chmod(0o600)
        stage.chmod(0o700)
        os.replace(stage, destination)
    except BaseException:
        shutil.rmtree(stage, ignore_errors=True)
        raise
    print(f"Backup created: {backup_id}")
    print(f"Source: {origin}")
    print(f"Stored under: {destination}")
    return 0


def backup_target(source: str) -> Path:
    home = Path.home()
    if source.startswith("repo:"):
        relative = Path(source.removeprefix("repo:"))
        root = REPO_ROOT / "config"
    elif source.startswith("home:"):
        relative = Path(source.removeprefix("home:"))
        root = home / ".config"
    else:
        raise ConfigError("backup manifest has an unknown source domain")
    if relative.is_absolute() or not relative.parts or any(part in {".", ".."} for part in relative.parts):
        raise ConfigError("backup manifest contains an unsafe destination path")
    if source.startswith("repo:") and relative.parts[0] != "config":
        raise ConfigError("repository backup destination is outside config/")
    if source.startswith("home:") and relative.parts[0] != ".config":
        raise ConfigError("home backup destination is outside ~/.config/")
    target = REPO_ROOT / relative if source.startswith("repo:") else home / relative
    if root.is_symlink():
        raise ConfigError(f"refusing to restore through a symlinked config root: {root}")
    if not target.resolve(strict=False).is_relative_to(root.resolve(strict=False)):
        raise ConfigError("backup destination resolves outside its allowed config tree")
    parent = target.parent
    while parent != root.parent:
        if parent.is_symlink():
            raise ConfigError(f"refusing to restore through a symlinked parent: {parent}")
        if parent.exists() and not parent.is_dir():
            raise ConfigError(f"restore parent is not a directory: {parent}")
        if parent == root:
            break
        parent = parent.parent
    if not root.is_dir():
        raise ConfigError(f"restore config root is missing: {root}")
    if not target.parent.is_dir():
        raise ConfigError(f"restore parent directory is missing: {target.parent}")
    return target


def read_backup(backup_id: str) -> tuple[Path, dict, Path]:
    if not BACKUP_ID_RE.fullmatch(backup_id):
        raise ConfigError("backup ID has an invalid format")
    root = backup_root(create=False)
    directory = root / backup_id
    if directory.is_symlink() or not directory.is_dir():
        raise ConfigError(f"backup does not exist or is not a directory: {backup_id}")
    info = directory.stat()
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ConfigError(f"backup directory is not private and user-owned: {backup_id}")
    manifest_path = directory / "manifest.json"
    if manifest_path.is_symlink() or not manifest_path.is_file():
        raise ConfigError("backup manifest is missing or unsafe")
    manifest_info = manifest_path.stat()
    if manifest_info.st_uid != os.getuid() or manifest_info.st_mode & 0o077:
        raise ConfigError("backup manifest is not private and user-owned")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ConfigError(f"cannot read backup manifest: {error}") from error
    if not isinstance(manifest, dict) or manifest.get("version") != 1 or manifest.get("id") != backup_id:
        raise ConfigError("backup manifest has an unsupported version or ID")
    if manifest.get("kind") not in {"file", "directory"} or not isinstance(manifest.get("source"), str):
        raise ConfigError("backup manifest has invalid source metadata")
    payload = directory / "payload"
    if payload.is_symlink():
        raise ConfigError("backup payload must not be a symlink")
    if manifest["kind"] == "file" and not payload.is_file():
        raise ConfigError("backup payload is not a regular file")
    if manifest["kind"] == "directory" and not payload.is_dir():
        raise ConfigError("backup payload is not a directory")
    return directory, manifest, payload


def copy_backup_payload(payload: Path, kind: str, target: Path) -> None:
    stage = Path(tempfile.mkdtemp(prefix=f".hexen-restore-{secrets.token_hex(4)}-", dir=target.parent))
    staged = stage / "payload"
    try:
        if kind == "directory":
            shutil.copytree(payload, staged, symlinks=True, copy_function=shutil.copy2)
            if target.exists():
                previous = stage / "previous"
                moved_previous = False
                try:
                    os.replace(target, previous)
                    moved_previous = True
                    os.replace(staged, target)
                except BaseException:
                    if moved_previous and previous.exists() and not target.exists():
                        os.replace(previous, target)
                    raise
                shutil.rmtree(previous)
            else:
                os.replace(staged, target)
        else:
            shutil.copy2(payload, staged)
            os.replace(staged, target)
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def command_restore(backup_id: str) -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise ConfigError("config restore requires an interactive terminal")
    _, manifest, payload = read_backup(backup_id)
    target = backup_target(manifest["source"])
    if target.is_symlink():
        raise ConfigError(f"refusing to replace a symlink at restore destination: {target}")
    target_exists = target.exists()
    if target_exists and manifest["kind"] == "file" and not target.is_file():
        raise ConfigError("backup is a file but the restore destination is not a regular file")
    if target_exists and manifest["kind"] == "directory" and not target.is_dir():
        raise ConfigError("backup is a directory but the restore destination is not a directory")

    print(f"Backup: {backup_id}")
    print(f"Restore destination: {target}")
    if target_exists:
        print("The existing destination will first be copied to a new safety backup.")
    try:
        answer = input("Restore this config? [y/N] ").strip().lower()
    except EOFError as error:
        raise ConfigError("confirmation input closed; nothing was restored") from error
    if answer not in {"y", "yes"}:
        print("Restore cancelled.")
        return 0

    if target_exists:
        command_backup(str(target))
    copy_backup_payload(payload, manifest["kind"], target)
    if target_exists:
        print("The previous destination is preserved in the safety backup created above.")
    print("Restore complete.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="hexen", description="Hexen workstation tools")
    groups = parser.add_subparsers(dest="group", required=True)
    update = groups.add_parser("update", help="inspect status or run a confirmed system package update")
    update.add_argument("--check", action="store_true",
                        help="show available updates without changing anything")
    update.add_argument("--vm", action="store_true",
                        help="use nested-VM network settings for optional Ansible convergence")
    update_monitor = groups.add_parser(
        "update-monitor",
        help="check Arch updates daily without installing; save a private review report",
    )
    update_monitor_commands = update_monitor.add_subparsers(dest="monitor_command")
    update_review = update_monitor_commands.add_parser(
        "review", help="review each available package before the full update workflow",
    )
    update_review.add_argument(
        "--vm", action="store_true",
        help="use nested-VM network settings for optional Ansible convergence",
    )
    groups.add_parser("migrate", help="review and run pending per-user Hexen migrations")
    config = groups.add_parser("config", help="inspect managed configuration")
    config_commands = config.add_subparsers(dest="command", required=True)
    config_commands.add_parser("status", help="show profile, repo state, and managed links")
    config_commands.add_parser("diff", help="show staged and unstaged repository edits")
    apply = config_commands.add_parser("apply", help="review and apply workstation configuration")
    apply.add_argument("--vm", action="store_true", help="use the nested-VM network settings")
    backup = config_commands.add_parser("backup", help="copy a config path into private Hexen state")
    backup.add_argument("path", help="path under config/ or ~/.config/ (relative paths default to ~/.config)")
    restore = config_commands.add_parser("restore", help="restore an identified backup after confirmation")
    restore.add_argument("backup_id", help="ID printed by hexen config backup")
    args = parser.parse_args()

    try:
        if args.group == "update":
            return command_update_check() if args.check else command_update(args.vm)
        if args.group == "update-monitor":
            if args.monitor_command == "review":
                return command_update_review(args.vm)
            return command_update_monitor().exit_code
        if args.group == "migrate":
            return command_migrate()
        if args.group == "config" and args.command == "status":
            return command_status()
        if args.group == "config" and args.command == "diff":
            return command_diff()
        if args.group == "config" and args.command == "apply":
            return command_apply(args.vm)
        if args.group == "config" and args.command == "backup":
            return command_backup(args.path)
        if args.group == "config" and args.command == "restore":
            return command_restore(args.backup_id)
    except KeyboardInterrupt:
        print("hexen: interrupted; no further changes will be made", file=sys.stderr)
        return 130
    except (ConfigError, OSError, UnicodeError) as error:
        print(f"hexen: {error}", file=sys.stderr)
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
