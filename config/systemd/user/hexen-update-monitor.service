[Unit]
Description=Check Arch package updates for Hexen review
Documentation=https://man.archlinux.org/man/extra/pacman-contrib/checkupdates.8.en

StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=5min
ExecStart=%h/.local/bin/hexen update-monitor
TimeoutStartSec=20min
UMask=0077
