# Mako notification daemon configuration
# Neon cyber green style

max-visible=5
sort=-time
layer=overlay
anchor=top-right

font=JetBrainsMono Nerd Font 11
background-color=#06120eee
text-color=#b8ffe4
border-color=#00ff9c
border-radius=10
border-size=2
padding=12
margin=12
width=380
height=150

default-timeout=5000
ignore-timeout=0

icons=1
max-icon-size=48
icon-location=left

on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all

[urgency=low]
border-color=#00e5ff
default-timeout=3000

[urgency=normal]
border-color=#00ff9c

[urgency=critical]
border-color=#ff5c7a
background-color=#1a0a10f0
default-timeout=0
ignore-timeout=1

[mode=do-not-disturb]
invisible=1
